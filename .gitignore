# 项目特定的忽略文件

# 上传文件（只包含代码和图标，排除用户上传的文件）
backend/uploads/**/*
!backend/uploads/.gitkeep
!backend/uploads/*/.gitkeep

# Python相关
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js相关
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建输出
dist/
build/
out/

# IDE和编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
*.log
logs/

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 覆盖率目录
coverage/
*.lcov

# 依赖目录
jspm_packages/

# TypeScript缓存
*.tsbuildinfo

# 可选的npm缓存目录
.npm

# 可选的eslint缓存
.eslintcache

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 临时文件
*.tmp
*.temp

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 压缩文件（如果不是项目必需的）
*.zip
*.tar.gz
*.rar

# 备份文件
*.bak
*.backup

# macOS
*.DS_Store

# Windows
*.exe
*.msi

# 用户数据导出（可能包含敏感信息）
**/user_data_export.json 